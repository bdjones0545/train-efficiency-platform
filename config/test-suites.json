{
  "version": 1,
  "classifications": {
    "static": "STATIC / SOURCE INSPECTION",
    "unit": "UNIT",
    "db": "DB INTEGRATION",
    "server": "LIVE SERVER / API",
    "e2e": "BROWSER / E2E",
    "external": "PROVIDER / EXTERNAL INTEGRATION"
  },
  "suites": {
    "default": {
      "command": "npm test",
      "description": "Non-mutating tests with network and real database access disabled",
      "dependencies": ["Node.js", "tsx"],
      "mutating": false,
      "safeForLocalDefault": true,
      "safeForCI": true,
      "requiredEnvironment": []
    },
    "unit": {
      "command": "npm run test:unit",
      "description": "Unit and source-inspection tests that need no infrastructure",
      "dependencies": ["Node.js", "tsx"],
      "mutating": false,
      "safeForLocalDefault": true,
      "safeForCI": true,
      "requiredEnvironment": []
    },
    "security": {
      "command": "npm run test:security",
      "description": "Logging, authorization, tenant-isolation, and secret-handling regressions",
      "dependencies": ["Node.js", "tsx"],
      "mutating": false,
      "safeForLocalDefault": true,
      "safeForCI": true,
      "requiredEnvironment": []
    },
    "db": {
      "command": "npm run test:db",
      "description": "Tests that read and write an explicitly designated disposable test database",
      "dependencies": ["PostgreSQL"],
      "mutating": true,
      "safeForLocalDefault": false,
      "safeForCI": true,
      "requiredEnvironment": ["TEST_DATABASE_URL"]
    },
    "server": {
      "command": "npm run test:server",
      "description": "Tests against an already-running non-production API",
      "dependencies": ["running TrainEfficiency API"],
      "mutating": true,
      "safeForLocalDefault": false,
      "safeForCI": true,
      "requiredEnvironment": ["TEST_BASE_URL"]
    },
    "e2e": {
      "command": "npm run test:e2e",
      "description": "Reserved classification; no browser runner is installed",
      "dependencies": ["browser runner (not installed)"],
      "mutating": false,
      "safeForLocalDefault": false,
      "safeForCI": false,
      "requiredEnvironment": []
    }
  },
