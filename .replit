modules = ["nodejs-20", "web", "python-3.11", "postgresql-16"]
  run = "npm run dev"
  hidden = [".config", ".git", "generated-icon.png", "node_modules", "dist"]

  [nix]
  channel = "stable-24_05"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5111
externalPort = 3000

  [env]
  PORT = "5000"

  [deployment]
deploymentTarget = "autoscale"
run = ["node", "dist/index.cjs"]
build = ["npm", "run", "build"]
publicDir = "dist/public"

  [workflows]
  runButton = "Project"

  [[workflows.workflow]]
  name = "Project"
  mode = "parallel"
  author = "agent"

  [[workflows.workflow.tasks]]
  task = "workflow.run"
  args = "Start application"

  [[workflows.workflow.tasks]]
  task = "workflow.run"
  args = "typecheck"

  [[workflows.workflow]]
  name = "Start application"
  author = "agent"

  [[workflows.workflow.tasks]]
  task = "shell.exec"
  args = "npm run dev"
  waitForPort = 5000

  [[workflows.workflow]]
  name = "typecheck"
  author = "agent"

  [workflows.workflow.metadata]
  isValidation = true

  [[workflows.workflow.tasks]]
  task = "shell.exec"
  args = "npx tsc --noEmit -p tsconfig.client.json 2>&1 | grep -E 'TS2304|TS2552' && echo 'UNDEFINED_NAME_ERRORS_FOUND' && exit 1 || echo 'No undefined-name errors'"

  [agent]
integrations = ["javascript_log_in_with_replit:2.0.0", "javascript_database:1.0.0", "javascript_openai_ai_integrations:2.0.0", "sendgrid:1.0.0", "stripe:2.0.0", "javascript_stripe:1.0.0", "javascript_object_storage:2.0.0", "github:1.0.0"]

  [[mcp.servers]]
  url = "https://trainefficiency.ngrok.app/mcp/"

  [userenv]

  [userenv.shared]
  # ADMIN_REPAIR_KEY is a secret and must NOT be committed here.
  # Set it (rotated) in Replit Secrets / the deployment environment instead.
  AGENTMAIL_ORG_DOMAIN = "trainefficiency.com"
GOOGLE_CLIENT_ID = "314571901016-72muc79kiniis3cksinr6e7ltud4636d.apps.googleusercontent.com"
META_BOOK_PIXEL_ID = "1017450327750475"
KEVIN_INTEGRATION_ENABLED = "true"
KEVIN_HERMES_BASE_URL = "https://kevin-api.trainefficiency.com"
TRAINEFFICIENCY_BASE_URL = "http://localhost:5000"
TRAINEFFICIENCY_KEVIN_SERVICE_ID = "kevin-executive-agent"
TRAINEFFICIENCY_KEVIN_KEY_ID = "kevin-key-v1"
TRAINEFFICIENCY_DEFAULT_ORG_ID = "97c352ba-fd14-41d4-a081-6c219e1bea21"
TRAINEFFICIENCY_REQUEST_TIMEOUT_MS = "30000"
KEVIN_GATEWAY_BASE_URL = "https://kevin-api.trainefficiency.com"
KEVIN_OUTBOUND_HMAC_SECRET = "79f3830a8761a5c18bc8788a3558947642f4d6d8a14b9d48d181cf94041e6e6e"
KEVIN_CALLBACK_HMAC_SECRET = "79f3930a8761a5c18bc8788a3558947642f4d6d8a14b9d40d181cf94041e6e6e"
KEVIN_REQUEST_TIMEOUT_MS = "8000"
KEVIN_CALLBACK_ALLOWED_SKEW_SECONDS = "300"
KEVIN_INBOUND_HMAC_SECRET = "79f3930a8761a5c18bc8788a3558947642f4d6d8a14b9d40d181g f94041ебебе"

  [userenv.production]
  PUBLIC_APP_URL = "https://trainefficiency.com"
KEVIN_AGENT_INTEGRATION_ENABLED = "true"
KEVIN_CALLBACK_BASE_URL = "https://trainefficiency.com"

[userenv.development]
KEVIN_AGENT_INTEGRATION_ENABLED = "true"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000
  