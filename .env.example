# TrainEfficiency — environment variables
#
# Copy to `.env` for local development and fill in real values, OR set these in
# the deployment environment (Replit Secrets) for production. NEVER commit real
# secret values to source control.
#
# In production (NODE_ENV=production) the app FAILS CLOSED at startup if any
# secret marked [REQUIRED IN PROD] is missing (see server/lib/secrets.ts).

# ── Core ──────────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://user:password@host:5432/dbname   # [REQUIRED] Postgres connection string
NODE_ENV=development                                      # development | production
PORT=5000

# ── Secrets (fail closed in production) ───────────────────────────────────────
# Signs sessions and OAuth-state HMACs. Use a long random string.
#   e.g. `openssl rand -hex 32`
SESSION_SECRET=                                           # [REQUIRED IN PROD]

# Encrypts stored third-party integration credentials (Gmail/Slack/Calendar) in
# the credentials vault (AES-256-GCM). MUST be at least 32 chars and MUST be a
# DIFFERENT value from SESSION_SECRET. Rotating this makes previously stored
# credentials undecryptable, so keep it stable (or plan a re-encryption).
#   e.g. `openssl rand -hex 32`
CREDENTIAL_ENCRYPTION_KEY=                                # [REQUIRED IN PROD]

# Gates admin "repair" endpoints via the x-admin-key header. Was previously
# committed in .replit — rotate and set here / in Secrets only. If unset, the
# repair endpoints deny all access (fail closed).
ADMIN_REPAIR_KEY=

# ── Payments (Stripe) ─────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MARKETPLACE_WEBHOOK_SECRET=

# ── AI ────────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# ── Email / SMS ───────────────────────────────────────────────────────────────
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_INBOUND_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── Integrations ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
COMPOSIO_API_KEY=
AGENTMAIL_API_KEY=
AGENTMAIL_WEBHOOK_SECRET=
META_CAPI_TOKEN=
META_BOOK_ACCESS_TOKEN=

# ── TrainChat cross-platform API ──────────────────────────────────────────────
TRAINCHAT_API_KEY=
TRAINCHAT_API_BASE_URL=

# ── Kevin orchestrator (Hermes profile kevin) — Phases 0–3 ───────────────────
# BFF-only. Browser never receives these values.
# Default OFF for production safety; enable after Hermes API Server is up.
# Preferred flag name (either this or legacy enables):
KEVIN_AGENT_INTEGRATION_ENABLED=false
# Legacy alias (still honored if preferred unset/false):
KEVIN_INTEGRATION_ENABLED=false
# Base URL of Hermes API Server (loopback / private network preferred)
# e.g. http://127.0.0.1:8642  or  https://kevin-ops.internal
KEVIN_HERMES_BASE_URL=
# Must match API_SERVER_KEY on the kevin Hermes profile
KEVIN_HERMES_API_KEY=
#
# Phase 3: Internal service-to-service auth (Kevin→TE signal intake).
# Kevin uses this token to POST to /api/internal/kevin/signals.
# Min 24 chars. Generate: openssl rand -hex 32
# NEVER log or return in API responses.
TE_INTERNAL_SERVICE_TOKEN=
#
# Phase 3: Feature flags (independent, default off — enable incrementally).
# See docs/kevin-integration.md for staged activation sequence.
#
# Stage 1 — context only (safe, read-only):
KEVIN_CONTEXT_RETRIEVAL_ENABLED=false    # Hermes /v1/context/query — pending
#
# Stage 2 — event dispatch:
KEVIN_EVENT_DISPATCH_ENABLED=false       # Hermes /v1/events — pending
#
# Stage 3 — outcome forwarding:
KEVIN_OUTCOME_FORWARDING_ENABLED=false   # Hermes /v1/outcomes — pending
#
# Stage 4 — inbound signal intake (requires strong token above):
KEVIN_SIGNAL_INTAKE_ENABLED=false        # POST /api/internal/kevin/signals

# Default TE→Hermes HTTP timeout (ms). Default 8000. Clamp 1000–120000.
# Run-create uses max(30000, this value).
KEVIN_REQUEST_TIMEOUT_MS=8000

# Max |now - x-kevin-timestamp| for Kevin→TE callback HMAC verify (seconds).
# Default 300. Clamp 30–3600.
KEVIN_CALLBACK_ALLOWED_SKEW_SECONDS=300

# TE public origin for Kevin→TE callback POSTs (no trailing slash). Not a secret.
# Distinct from KEVIN_HERMES_BASE_URL (that is TE→Kevin Hermes API).
# Fallback chain if unset: TE_APP_BASE_URL → APP_BASE_URL → PUBLIC_APP_URL → default https://trainefficiency.com
KEVIN_CALLBACK_BASE_URL=https://trainefficiency.com

# Kevin → TE callback plane (webhooks / async notifications). Server-side only.
# Preferred Replit name. Same value as KEVIN_OUTBOUND_HMAC_SECRET + TRAINEFFICIENCY_KEVIN_SIGNING_SECRET.
# HMAC-SHA256 v1 headers: x-kevin-timestamp + x-kevin-signature (see shared/kevin/outbound-hmac.ts)
KEVIN_CALLBACK_HMAC_SECRET=
# Alternate name (optional if CALLBACK set) — keep identical when both present
KEVIN_OUTBOUND_HMAC_SECRET=
# Legacy alias (optional) — keep identical when present
TRAINEFFICIENCY_KEVIN_SIGNING_SECRET=
# Optional separate bearer for Kevin→TE internal routes (not the HMAC secret)
TE_INTERNAL_SERVICE_TOKEN=

# Kevin Slack Executive Ops Hub (inbound Slack → TE BFF). Default OFF.
# Distinct from Composio #kevin-ops platform notify and org webhook alerts.
# Do not enable until Phase 1+ identity mapping + signing secret are live.
KEVIN_SLACK_EOH_ENABLED=false
# Slack signing secret for Events/Interactivity/Slash (never commit real value)
KEVIN_SLACK_SIGNING_SECRET=
# Optional public app base for allowlisted deep links in Block Kit buttons
TE_APP_BASE_URL=

# ── Background jobs ───────────────────────────────────────────────────────────
# Enables the durable, idempotent workflow job queue (recommended in production).
USE_WORKFLOW_JOB_QUEUE=false

# ── Automation safety ─────────────────────────────────────────────────────────
# Global emergency off-switch for AUTOMATED OUTREACH email sends (the guarded
# outbound-email chain used by cron/agent paths). Set to exactly "false" or "0"
# to halt all automated outreach without a code deploy; unset (or any other
# value) leaves sends ENABLED — the default behavior. Transactional emails
# (booking confirmations, reminders, receipts) are sent via a separate path and
# are intentionally NOT affected by this switch.
AUTOMATION_SENDS_ENABLED=
